# Customer predicates
chorki_customers.id: string @index(exact) .
chorki_customers.name: string @index(term, fulltext) .
chorki_customers.email: string @index(hash, exact, fulltext) .
chorki_customers.phone: string @index(exact) .
chorki_customers.age: int @index(int) .
chorki_customers.country: string @index(exact) .
chorki_customers.city: string @index(exact) .
chorki_customers.device: string @index(exact) .
chorki_customers.app_version: string @index(exact) .
chorki_customers.registration_date: datetime @index(hour) .
chorki_customers.last_login: datetime @index(hour) .
chorki_customers.last_login_days: int @index(int) .
chorki_customers.is_active: bool @index(bool) .
chorki_customers.created_at: datetime @index(hour) .
chorki_customers.updated_at: datetime .
chorki_customers.metadata: string .
chorki_customers.subscriptions: [uid] @reverse .
chorki_customers.watch_histories: [uid] @reverse .
chorki_customers.devices: [uid] @reverse .

# Subscription predicates
chorki_subscriptions.id: string @index(exact) .
chorki_subscriptions.customer_id: string @index(exact) .
chorki_subscriptions.package: string @index(exact) .
chorki_subscriptions.status: string @index(exact) .
chorki_subscriptions.start_date: datetime @index(hour) .
chorki_subscriptions.end_date: datetime @index(hour) .
chorki_subscriptions.price: float @index(float) .
chorki_subscriptions.currency: string @index(exact) .
chorki_subscriptions.payment_method: string @index(exact) .
chorki_subscriptions.auto_renewal: bool @index(bool) .
chorki_subscriptions.trial_period: bool @index(bool) .
chorki_subscriptions.created_at: datetime @index(hour) .
chorki_subscriptions.updated_at: datetime .
chorki_subscriptions.customer: uid @reverse .

# Watch history predicates
chorki_watch_histories.id: string @index(exact) .
chorki_watch_histories.customer_id: string @index(exact) .
chorki_watch_histories.content_id: int @index(int) .
chorki_watch_histories.content_title: string @index(term, fulltext) .
chorki_watch_histories.type: string @index(exact) .
chorki_watch_histories.genre: [string] @index(exact) .
chorki_watch_histories.duration_watched: int @index(int) .
chorki_watch_histories.total_duration: int @index(int) .
chorki_watch_histories.completion_percentage: float @index(float) .
chorki_watch_histories.watch_date: datetime @index(hour) .
chorki_watch_histories.device_used: string @index(exact) .
chorki_watch_histories.quality: string @index(exact) .
chorki_watch_histories.created_at: datetime @index(hour) .
chorki_watch_histories.customer: uid @reverse .
chorki_watch_histories.content: uid @reverse .

# Content predicates
chorki_contents.id: int @index(int) .
chorki_contents.title: string @index(term, fulltext) .
chorki_contents.type: string @index(exact) .
chorki_contents.genre: [string] @index(exact) .
chorki_contents.duration: int @index(int) .
chorki_contents.release_year: int @index(int) .
chorki_contents.rating: float @index(float) .
chorki_contents.language: string @index(exact) .
chorki_contents.country: string @index(exact) .
chorki_contents.director: string @index(term) .
chorki_contents.cast: [string] @index(term) .
chorki_contents.description: string @index(fulltext) .
chorki_contents.thumbnail_url: string .
chorki_contents.video_url: string .
chorki_contents.is_premium: bool @index(bool) .
chorki_contents.is_active: bool @index(bool) .
chorki_contents.created_at: datetime @index(hour) .
chorki_contents.updated_at: datetime .
chorki_contents.watch_histories: [uid] @reverse .

# Device predicates
chorki_devices.id: string @index(exact) .
chorki_devices.customer_id: string @index(exact) .
chorki_devices.device_type: string @index(exact) .
chorki_devices.device_model: string @index(exact) .
chorki_devices.os_version: string @index(exact) .
chorki_devices.app_version: string @index(exact) .
chorki_devices.push_token: string @index(hash) .
chorki_devices.is_active: bool @index(bool) .
chorki_devices.last_used: datetime @index(hour) .
chorki_devices.created_at: datetime @index(hour) .
chorki_devices.updated_at: datetime .
chorki_devices.customer: uid @reverse .

# Types
type chorki_customers {
  chorki_customers.id
  chorki_customers.name
  chorki_customers.email
  chorki_customers.phone
  chorki_customers.age
  chorki_customers.country
  chorki_customers.city
  chorki_customers.device
  chorki_customers.app_version
  chorki_customers.registration_date
  chorki_customers.last_login
  chorki_customers.last_login_days
  chorki_customers.is_active
  chorki_customers.created_at
  chorki_customers.updated_at
  chorki_customers.metadata
  chorki_customers.subscriptions
  chorki_customers.watch_histories
  chorki_customers.devices
}

type chorki_subscriptions {
  chorki_subscriptions.id
  chorki_subscriptions.customer_id
  chorki_subscriptions.package
  chorki_subscriptions.status
  chorki_subscriptions.start_date
  chorki_subscriptions.end_date
  chorki_subscriptions.price
  chorki_subscriptions.currency
  chorki_subscriptions.payment_method
  chorki_subscriptions.auto_renewal
  chorki_subscriptions.trial_period
  chorki_subscriptions.created_at
  chorki_subscriptions.updated_at
  chorki_subscriptions.customer
}

type chorki_watch_histories {
  chorki_watch_histories.id
  chorki_watch_histories.customer_id
  chorki_watch_histories.content_id
  chorki_watch_histories.content_title
  chorki_watch_histories.type
  chorki_watch_histories.genre
  chorki_watch_histories.duration_watched
  chorki_watch_histories.total_duration
  chorki_watch_histories.completion_percentage
  chorki_watch_histories.watch_date
  chorki_watch_histories.device_used
  chorki_watch_histories.quality
  chorki_watch_histories.created_at
  chorki_watch_histories.customer
  chorki_watch_histories.content
}

type chorki_contents {
  chorki_contents.id
  chorki_contents.title
  chorki_contents.type
  chorki_contents.genre
  chorki_contents.duration
  chorki_contents.release_year
  chorki_contents.rating
  chorki_contents.language
  chorki_contents.country
  chorki_contents.director
  chorki_contents.cast
  chorki_contents.description
  chorki_contents.thumbnail_url
  chorki_contents.video_url
  chorki_contents.is_premium
  chorki_contents.is_active
  chorki_contents.created_at
  chorki_contents.updated_at
  chorki_contents.watch_histories
}

type chorki_devices {
  chorki_devices.id
  chorki_devices.customer_id
  chorki_devices.device_type
  chorki_devices.device_model
  chorki_devices.os_version
  chorki_devices.app_version
  chorki_devices.push_token
  chorki_devices.is_active
  chorki_devices.last_used
  chorki_devices.created_at
  chorki_devices.updated_at
  chorki_devices.customer
}